<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="100%" height="100%">
  <rect width="800" height="400" fill="#020617" rx="12"/>
  <rect x="20" y="20" width="760" height="360" fill="#0f172a" rx="8" stroke="#1e293b" stroke-width="2"/>

  <!-- Header -->
  <path d="M20 20 h760 v40 h-760 z" fill="#1e293b"/>
  <text x="50" y="45" fill="#38bdf8" font-family="monospace" font-size="14" font-weight="bold">github.com/actions/checkout/releases</text>

  <!-- Content -->
  <text x="50" y="95" fill="#f8fafc" font-family="sans-serif" font-size="20" font-weight="bold">Releases · actions/checkout</text>

  <!-- Release Item 1 -->
  <rect x="50" y="120" width="700" height="100" fill="#1e293b" rx="6" stroke="#0284c7" stroke-width="1"/>
  <text x="70" y="150" fill="#38bdf8" font-family="sans-serif" font-size="16" font-weight="bold">v7.0.0 (Latest Release)</text>
  <text x="650" y="150" fill="#94a3b8" font-family="sans-serif" font-size="12">Released recently</text>
  <text x="70" y="180" fill="#cbd5e1" font-family="sans-serif" font-size="13">Official GitHub Action for checking out a repository in workflow automation.</text>

  <!-- Release Item 2 -->
  <rect x="50" y="240" width="700" height="100" fill="#1e293b" rx="6" stroke="#334155" stroke-width="1"/>
  <text x="70" y="270" fill="#94a3b8" font-family="sans-serif" font-size="16" font-weight="bold">v5.0.1</text>
  <text x="650" y="270" fill="#64748b" font-family="sans-serif" font-size="12">Released Nov 17, 2025</text>
  <text x="70" y="300" fill="#64748b" font-family="sans-serif" font-size="13">Major version update introducing Node 20 runtime support.</text>
</svg>
